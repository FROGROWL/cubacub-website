# This file is only a template. The Django app does not read .env.example.
# For local development, create backend/.env using this file as a guide.
# For Render, add these values in the Render Environment dashboard instead.

SECRET_KEY=replace-this-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Local development: leave DATABASE_URL blank and use DB_* values below.
# Render production: set DATABASE_URL in the Render dashboard using the Internal Database URL.
DATABASE_URL=

DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=your_database_host
DB_PORT=5432

# Optional: used by python manage.py ensure_superuser.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=your-email@example.com
DJANGO_SUPERUSER_PASSWORD=use-a-strong-password
